<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Converge — AI Sales Closer for Websites</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --black: #060608;
  --deep: #0d0d12;
  --card: #111118;
  --border: #1e1e2a;
  --border-light: #2a2a3a;
  --green: #00e87a;
  --green-glow: rgba(0,232,122,0.12);
  --green-glow-s: rgba(0,232,122,0.3);
  --white: #f0f0f5;
  --muted: #6b6b80;
  --muted2: #9090a8;
  --purple: #7c5cfc;
  --purple-glow: rgba(124,92,252,0.15);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;font-weight:300;line-height:1.6;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9999;opacity:.45;}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:18px 52px;background:linear-gradient(to bottom,rgba(6,6,8,.97) 0%,transparent 100%);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.04);}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:21px;letter-spacing:-.5px;color:var(--white);text-decoration:none;display:flex;align-items:center;gap:9px;}
.logo-dot{width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);animation:pulse 2s ease infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.nav-links{display:flex;gap:28px;align-items:center;}
.nav-links a{color:var(--muted2);text-decoration:none;font-size:14px;font-weight:400;transition:color .2s;}
.nav-links a:hover{color:var(--white);}
.nav-cta{background:var(--green);color:var(--black);padding:9px 22px;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;transition:all .2s;}
.nav-cta:hover{background:#00ff88;box-shadow:0 0 24px var(--green-glow-s);}

/* ── HERO ── */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:120px 48px 80px;position:relative;overflow:hidden;text-align:center;}
.hero-glow{position:absolute;width:1000px;height:1000px;border-radius:50%;background:radial-gradient(circle,rgba(0,232,122,.06) 0%,transparent 65%);top:50%;left:50%;transform:translate(-50%,-62%);pointer-events:none;}
.hero-glow2{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(124,92,252,.05) 0%,transparent 70%);top:60%;left:20%;pointer-events:none;}
.badge{display:inline-flex;align-items:center;gap:8px;background:rgba(0,232,122,.08);border:1px solid rgba(0,232,122,.2);padding:6px 16px;border-radius:100px;font-family:'DM Mono',monospace;font-size:11px;color:var(--green);letter-spacing:1px;text-transform:uppercase;margin-bottom:28px;animation:fu .8s ease both;}
.badge-dot{width:6px;height:6px;border-radius:50%;background:var(--green);animation:pulse 1.5s infinite;}
h1{font-family:'Syne',sans-serif;font-size:clamp(44px,7vw,86px);font-weight:800;line-height:1.0;letter-spacing:-3px;max-width:940px;animation:fu .8s .1s ease both;}
h1 em{font-style:normal;color:var(--green);}
.hero-sub{font-size:clamp(16px,2vw,19px);color:var(--muted2);max-width:560px;margin:24px auto 0;font-weight:300;line-height:1.7;animation:fu .8s .2s ease both;}
.hero-actions{display:flex;gap:14px;margin-top:40px;justify-content:center;animation:fu .8s .3s ease both;flex-wrap:wrap;}
.btn-p{background:var(--green);color:var(--black);padding:14px 32px;border-radius:8px;border:none;font-size:15px;font-weight:600;cursor:pointer;text-decoration:none;transition:all .2s;display:inline-flex;align-items:center;gap:8px;font-family:'DM Sans',sans-serif;}
.btn-p:hover{background:#00ff88;box-shadow:0 0 40px rgba(0,232,122,.4);transform:translateY(-1px);}
.btn-s{background:transparent;color:var(--white);padding:14px 32px;border-radius:8px;border:1px solid var(--border-light);font-size:15px;font-weight:400;cursor:pointer;text-decoration:none;transition:all .2s;font-family:'DM Sans',sans-serif;}
.btn-s:hover{border-color:var(--muted2);background:rgba(255,255,255,.04);}
.hero-stats{display:flex;gap:52px;margin-top:64px;justify-content:center;animation:fu .8s .4s ease both;flex-wrap:wrap;}
.stat{text-align:center;}
.stat-num{font-family:'Syne',sans-serif;font-size:30px;font-weight:800;}
.stat-num span{color:var(--green);}
.stat-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:4px;font-family:'DM Mono',monospace;}
@keyframes fu{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

/* ── TRUST BAR ── */
.trust-bar{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--deep);padding:26px 48px;}
.trust-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:36px;justify-content:center;flex-wrap:wrap;}
.trust-label{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;white-space:nowrap;}
.trust-logos{display:flex;gap:32px;align-items:center;flex-wrap:wrap;justify-content:center;}
.trust-logo{font-family:'Syne',sans-serif;font-weight:700;font-size:13px;color:var(--muted);opacity:.45;transition:opacity .2s;}
.trust-logo:hover{opacity:.9;}

/* ── SHARED SECTION ── */
section{padding:100px 48px;}
.sec-label{font-family:'DM Mono',monospace;font-size:11px;color:var(--green);text-transform:uppercase;letter-spacing:2px;margin-bottom:16px;}
h2{font-family:'Syne',sans-serif;font-weight:800;font-size:clamp(34px,4vw,52px);letter-spacing:-2px;line-height:1.05;}
h2 em{font-style:normal;color:var(--green);}
.sec-sub{font-size:17px;color:var(--muted2);max-width:520px;margin-top:16px;line-height:1.7;font-weight:300;}
.w1100{max-width:1100px;margin:0 auto;}

/* ── DEMO STRIP ── */
.demo-strip{padding:0 48px 80px;display:flex;justify-content:center;}
.demo-wrap{width:100%;max-width:1100px;border-radius:20px;overflow:hidden;border:1px solid var(--border);background:var(--deep);box-shadow:0 40px 120px rgba(0,0,0,.6);}
.browser-bar{background:#0a0a10;border-bottom:1px solid var(--border);padding:12px 20px;display:flex;align-items:center;gap:12px;}
.bdots{display:flex;gap:7px;}
.bdot{width:12px;height:12px;border-radius:50%;}
.bd-r{background:#ff5f57;}.bd-y{background:#ffbd2e;}.bd-g{background:#28ca41;}
.burl{flex:1;background:#131320;border-radius:6px;padding:6px 14px;font-family:'DM Mono',monospace;font-size:12px;color:var(--muted2);max-width:360px;margin:0 auto;}
.demo-grid{display:grid;grid-template-columns:1fr 380px;min-height:480px;}
.demo-site{padding:48px;background:linear-gradient(135deg,#0a0a10 0%,#0d0d18 100%);border-right:1px solid var(--border);}
.ds-logo{font-family:'Syne',sans-serif;font-weight:700;font-size:17px;color:#e0e0f0;margin-bottom:44px;opacity:.6;}
.ds-h{font-family:'Syne',sans-serif;font-weight:700;font-size:34px;line-height:1.15;letter-spacing:-1.5px;color:#e8e8f5;margin-bottom:14px;}
.ds-sub{color:var(--muted2);font-size:15px;line-height:1.7;max-width:380px;}
.ds-btns{display:flex;gap:12px;margin-top:28px;}
.ds-bp{background:#7c5cfc;color:#fff;padding:11px 22px;border-radius:8px;font-size:14px;font-weight:500;border:none;cursor:pointer;}
.ds-bs{background:transparent;color:#a0a0b8;padding:11px 22px;border-radius:8px;font-size:14px;border:1px solid #2a2a40;cursor:pointer;}
.ds-stats{display:flex;gap:28px;margin-top:36px;}
.ds-sn{font-family:'Syne',sans-serif;font-weight:700;font-size:22px;color:#e8e8f5;}
.ds-sl{font-size:12px;color:var(--muted);margin-top:2px;}

/* ── CHAT WIDGET ── */
.chat-panel{display:flex;flex-direction:column;background:var(--card);}
.chat-hdr{padding:18px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;}
.chat-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--green) 0%,#00c4ff 100%);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.chat-hi{flex:1;}
.chat-hn{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--white);}
.chat-hs{font-size:11px;color:var(--green);display:flex;align-items:center;gap:5px;margin-top:1px;}
.sdot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:pulse 1.5s infinite;}
.chat-pw{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted);}
.chat-msgs{flex:1;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;max-height:320px;}
.msg{max-width:88%;animation:mi .3s ease;}
@keyframes mi{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg-ai .msg-b{background:var(--deep);border:1px solid var(--border);border-radius:4px 14px 14px 14px;padding:10px 14px;font-size:13.5px;color:#d8d8e8;line-height:1.55;}
.msg-u{align-self:flex-end;}
.msg-u .msg-b{background:var(--green);color:var(--black);border-radius:14px 4px 14px 14px;padding:10px 14px;font-size:13.5px;font-weight:500;line-height:1.55;}
.msg-t{font-size:10px;color:var(--muted);margin-top:4px;font-family:'DM Mono',monospace;padding:0 4px;}
.msg-u .msg-t{text-align:right;}
.qrs{display:flex;flex-wrap:wrap;gap:7px;padding:0 16px 12px;}
.qr{background:transparent;border:1px solid var(--border-light);color:var(--muted2);padding:6px 12px;border-radius:100px;font-size:12px;cursor:pointer;transition:all .2s;font-family:'DM Sans',sans-serif;}
.qr:hover{border-color:var(--green);color:var(--green);background:var(--green-glow);}
.chat-inp-row{padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;align-items:center;}
.chat-inp{flex:1;background:var(--deep);border:1px solid var(--border);border-radius:8px;padding:9px 14px;font-size:13px;color:var(--white);outline:none;font-family:'DM Sans',sans-serif;}
.chat-inp:focus{border-color:var(--border-light);}
.chat-send{width:34px;height:34px;border-radius:8px;background:var(--green);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;}
.chat-send:hover{background:#00ff88;}
.typing{display:flex;gap:4px;padding:10px 14px;}
.typing span{width:6px;height:6px;border-radius:50%;background:var(--muted2);animation:td 1.2s ease infinite;}
.typing span:nth-child(2){animation-delay:.2s;}.typing span:nth-child(3){animation-delay:.4s;}
@keyframes td{0%,60%,100%{opacity:.3;transform:scale(1)}30%{opacity:1;transform:scale(1.3)}}

/* ── CONVERSATION SHOWCASE ── */
.convo-section{background:var(--deep);}
.convo-layout{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-top:64px;align-items:start;}
.convo-tabs{display:flex;flex-direction:column;gap:4px;}
.convo-tab{padding:20px 24px;border-radius:12px;border:1px solid transparent;cursor:pointer;transition:all .25s;}
.convo-tab.active{background:var(--card);border-color:rgba(0,232,122,.2);}
.convo-tab:hover:not(.active){background:rgba(255,255,255,.02);border-color:var(--border);}
.ct-label{font-family:'DM Mono',monospace;font-size:10px;color:var(--green);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px;}
.ct-title{font-family:'Syne',sans-serif;font-weight:700;font-size:16px;color:var(--white);margin-bottom:4px;}
.ct-desc{font-size:13px;color:var(--muted2);line-height:1.5;}
.convo-tab.active .ct-label{color:var(--green);}

.convo-preview{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;position:sticky;top:100px;}
.convo-ph{background:var(--deep);border-bottom:1px solid var(--border);padding:14px 20px;display:flex;align-items:center;gap:12px;}
.convo-ph-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--green),#00c4ff);display:flex;align-items:center;justify-content:center;font-size:14px;}
.convo-ph-name{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;}
.convo-ph-status{font-size:11px;color:var(--green);display:flex;align-items:center;gap:4px;margin-top:1px;}
.convo-msgs{padding:20px;display:flex;flex-direction:column;gap:10px;min-height:320px;}
.cm{max-width:85%;opacity:0;transform:translateY(8px);transition:opacity .4s ease,transform .4s ease;}
.cm.show{opacity:1;transform:translateY(0);}
.cm-ai .cm-b{background:var(--deep);border:1px solid var(--border);border-radius:4px 14px 14px 14px;padding:10px 14px;font-size:13.5px;color:#d8d8e8;line-height:1.55;}
.cm-u{align-self:flex-end;}
.cm-u .cm-b{background:var(--green);color:var(--black);border-radius:14px 4px 14px 14px;padding:10px 14px;font-size:13.5px;font-weight:500;line-height:1.55;}
.cm-label{font-size:10px;color:var(--muted);margin-top:4px;font-family:'DM Mono',monospace;padding:0 4px;}
.cm-u .cm-label{text-align:right;}
.convo-outcome{margin:0 20px 20px;background:var(--green-glow);border:1px solid rgba(0,232,122,.2);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:10px;opacity:0;transition:opacity .4s ease;}
.convo-outcome.show{opacity:1;}
.co-icon{font-size:18px;}
.co-text{font-size:13px;color:var(--green);font-family:'DM Mono',monospace;}

/* ── WHO IT'S FOR ── */
.for-section{background:var(--black);}
.for-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:64px;}
.for-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:36px;position:relative;overflow:hidden;transition:all .3s;cursor:default;}
.for-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;transition:opacity .3s;opacity:0;}
.for-card:hover{transform:translateY(-4px);border-color:var(--border-light);}
.for-card:hover::before{opacity:1;}
.for-card.fc-saas::before{background:linear-gradient(to right,transparent,var(--green),transparent);}
.for-card.fc-service::before{background:linear-gradient(to right,transparent,#f59e0b,transparent);}
.for-card.fc-agency::before{background:linear-gradient(to right,transparent,var(--purple),transparent);}
.for-icon{font-size:32px;margin-bottom:20px;}
.for-eyebrow{font-family:'DM Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;}
.fc-saas .for-eyebrow{color:var(--green);}
.fc-service .for-eyebrow{color:#f59e0b;}
.fc-agency .for-eyebrow{color:var(--purple);}
.for-title{font-family:'Syne',sans-serif;font-weight:800;font-size:22px;letter-spacing:-.5px;margin-bottom:12px;color:var(--white);}
.for-desc{font-size:14px;color:var(--muted2);line-height:1.7;margin-bottom:24px;}
.for-wins{display:flex;flex-direction:column;gap:8px;}
.fw{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:var(--muted2);}
.fw-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:7px;}
.fc-saas .fw-dot{background:var(--green);}
.fc-service .fw-dot{background:#f59e0b;}
.fc-agency .fw-dot{background:var(--purple);}
.for-quote{margin-top:24px;padding-top:20px;border-top:1px solid var(--border);font-size:13px;color:var(--muted2);font-style:italic;line-height:1.6;}
.for-quote::before{content:'"';font-size:22px;line-height:0;vertical-align:-8px;margin-right:2px;font-family:'Syne',sans-serif;font-style:normal;}
.fc-saas .for-quote::before{color:var(--green);}
.fc-service .for-quote::before{color:#f59e0b;}
.fc-agency .for-quote::before{color:var(--purple);}

/* ── HOW IT WORKS ── */
.how-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:64px;position:relative;}
.how-grid::before{content:'';position:absolute;top:28px;left:10%;right:10%;height:1px;background:linear-gradient(to right,transparent,var(--border-light) 20%,var(--border-light) 80%,transparent);}
.how-step{padding:0 16px;text-align:center;position:relative;}
.step-num{width:56px;height:56px;border-radius:50%;background:var(--card);border:1px solid var(--border-light);display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 20px;position:relative;z-index:1;transition:all .3s;}
.how-step:hover .step-num{background:var(--green-glow);border-color:var(--green);box-shadow:0 0 20px var(--green-glow);}
.step-title{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;color:var(--white);margin-bottom:8px;}
.step-desc{font-size:13px;color:var(--muted2);line-height:1.6;}

/* ── FEATURES ── */
.feat-section{background:var(--deep);}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);margin-top:64px;border-radius:16px;overflow:hidden;}
.feat-card{background:var(--card);padding:34px 30px;transition:all .3s;position:relative;overflow:hidden;}
.feat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--green),transparent);opacity:0;transition:opacity .3s;}
.feat-card:hover::before{opacity:1;}
.feat-card:hover{background:#13131c;}
.feat-icon{width:44px;height:44px;border-radius:10px;background:var(--green-glow);border:1px solid rgba(0,232,122,.2);display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:18px;}
.feat-title{font-family:'Syne',sans-serif;font-weight:700;font-size:17px;color:var(--white);margin-bottom:10px;}
.feat-desc{font-size:14px;color:var(--muted2);line-height:1.7;}

/* ── ROI CALC ── */
.roi-section{background:var(--black);}
.roi-inner{max-width:900px;margin:0 auto;}
.roi-card{background:var(--card);border:1px solid var(--border-light);border-radius:20px;padding:48px;margin-top:64px;position:relative;overflow:hidden;}
.roi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(to right,transparent,var(--green) 40%,var(--purple) 60%,transparent);}
.roi-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
.roi-input-g label{display:flex;justify-content:space-between;align-items:center;font-family:'DM Mono',monospace;font-size:12px;color:var(--muted2);margin-bottom:10px;}
.roi-vd{font-size:14px;color:var(--white);font-weight:500;}
.roi-slider{width:100%;-webkit-appearance:none;height:4px;border-radius:2px;background:var(--border-light);outline:none;cursor:pointer;}
.roi-slider::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--green);cursor:pointer;box-shadow:0 0 10px var(--green-glow-s);}
.roi-results{text-align:center;}
.roi-main{font-family:'Syne',sans-serif;font-weight:800;font-size:58px;letter-spacing:-3px;color:var(--green);line-height:1;}
.roi-label{font-family:'DM Mono',monospace;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-top:8px;}
.roi-bk{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px;}
.roi-bi{background:var(--deep);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center;}
.roi-bv{font-family:'Syne',sans-serif;font-weight:700;font-size:20px;color:var(--white);}
.roi-bl{font-size:11px;color:var(--muted);margin-top:3px;font-family:'DM Mono',monospace;}
.roi-disc{font-size:11px;color:var(--muted);margin-top:20px;text-align:center;font-style:italic;}

/* ── COMPARISON ── */
.comp-section{background:var(--deep);}
.comp-wrap{overflow-x:auto;margin-top:64px;}
.comp-table{width:100%;min-width:680px;border-collapse:collapse;border-radius:16px;overflow:hidden;border:1px solid var(--border);}
.comp-table th{background:var(--card);padding:18px 22px;text-align:left;font-family:'DM Mono',monospace;font-size:12px;color:var(--muted2);font-weight:400;letter-spacing:.5px;border-bottom:1px solid var(--border);}
.comp-table th.hl{background:linear-gradient(135deg,#111118,#0d1410);color:var(--green);border-bottom:2px solid var(--green);}
