// ── DEMO CHAT ──
const demoResponses={
  'Which plan is right for me?':["Quick question — how many people on your team?","Most teams with 10–20 people choose the Growth plan. You get unlimited conversations, CRM sync, and A/B testing. Want me to show you exactly what's included?","Here's what Growth gives you: unlimited AI conversations, 5 personas, Salesforce + HubSpot sync, A/B testing, and revenue attribution. It's $149/mo plus a small % of revenue we help you generate — so we only win when you do. Want to start a free trial?"],
  'Manage a team':["How big is the team?","For a 10–20 person team, ArcFlow's async check-ins and workload view is built for this. Most team leads say it saves 3 hours of meetings a week. Want to try it free?"],
  'This looks expensive':["I hear that. Most companies recover the full cost from one extra customer per month. At your traffic volume, that usually happens in the first week. Want me to show you the numbers?","Fair point — let's try it. I'll start you a free 14-day trial right now, no card needed. You can cancel anytime if it doesn't pay for itself. Sound good?"],
  'Book a demo':["Happy to! What timezone are you in?","I have slots this Thursday at 2pm or Friday at 10am. Which works better? I'll send you a calendar invite right away."],
  'default':["Good question. What's the main outcome you're hoping Converge helps you achieve?","The fastest way to see if it works is a free trial — you'll see the lift within a few days. Want me to set that up?"]
};
const dState={};
function sendQR(el,text){el.closest('.qrs').querySelectorAll('.qr').forEach(q=>q.style.opacity='.3');el.style.opacity='1';el.style.background='var(--green-glow)';el.style.borderColor='var(--green)';el.style.color='var(--green)';addDemoMsg(text,'u');const k=demoResponses[text]?text:'default';if(!dState[k])dState[k]=0;const replies=demoResponses[k];showDemoTyping(replies[Math.min(dState[k],replies.length-1)]);dState[k]++;}
function sendMessage(){const inp=document.getElementById('chatInput');const t=inp.value.trim();if(!t)return;inp.value='';addDemoMsg(t,'u');if(!dState.default)dState.default=0;showDemoTyping(demoResponses.default[Math.min(dState.default,1)]);dState.default++;}
function addDemoMsg(text,type){const msgs=document.getElementById('chatMessages');document.getElementById('quickReplies').innerHTML='';const d=document.createElement('div');d.className=type==='u'?'msg msg-u':'msg msg-ai';d.innerHTML=`<div class="msg-b">${text}</div><div class="msg-t">Just now</div>`;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;}
function showDemoTyping(text){const msgs=document.getElementById('chatMessages');const td=document.createElement('div');td.className='msg msg-ai';td.id='dTyping';td.innerHTML='<div class="msg-b"><div class="typing"><span></span><span></span><span></span></div></div>';msgs.appendChild(td);msgs.scrollTop=msgs.scrollHeight;setTimeout(()=>{const t=document.getElementById('dTyping');if(t)t.remove();addDemoMsg(text,'ai');const qr=document.getElementById('quickReplies');if(!qr.innerHTML){['Start free trial','View pricing','How does it work?'].forEach(r=>{const b=document.createElement('button');b.className='qr';b.textContent=r;b.onclick=function(){sendQR(this,r);};qr.appendChild(b);});}},1200+Math.random()*600);}

// ── CONVERSATION SHOWCASE ──
const scenarios=[
  {
    name:'Aria · Plan Advisor',
    status:'Active now',
    msgs:[
      {t:'u',text:"I'm not sure which plan is right for me."},
      {t:'ai',text:"No problem! Quick question — roughly how many people will be using it on your team?"},
      {t:'u',text:"About 15 people across two departments."},
      {t:'ai',text:"Got it. For a team that size, most companies choose the <strong>Growth plan</strong> — it gives you unlimited conversations, 5 AI personas, and full CRM sync. Want me to show you exactly what's included?"},
      {t:'u',text:"Yes, please."},
      {t:'ai',text:"Here's what you get: unlimited conversations, HubSpot + Salesforce sync, A/B conversation testing so you're always improving, and revenue attribution so you can prove the ROI. It's $149/mo plus a small % of revenue we help generate — so we only win when you do. Want to start a free trial right now?"},
      {t:'u',text:"Sure, let's do it."},
    ],
    outcome:{icon:'✓',text:'Growth plan free trial started'}
  },
  {
    name:'Aria · Objection Handler',
    status:'Active now',
    msgs:[
      {t:'u',text:"This looks expensive for what it does."},
      {t:'ai',text:"That's a fair thing to think. Can I show you something?"},
      {t:'u',text:"Go ahead."},
      {t:'ai',text:"Most companies recover the full cost from <strong>one extra customer per month</strong>. At typical traffic levels, that usually happens in the first week. So the real question isn't the cost — it's whether you can afford to keep missing those conversions."},
      {t:'u',text:"Fair point."},
      {t:'ai',text:"And you can try it completely free — 50 conversations, no card. If it doesn't pay for itself, you never upgrade. Want to start now?"},
      {t:'u',text:"Yeah, let's try it."},
    ],
    outcome:{icon:'✓',text:'Free plan activated — no card needed'}
  },
  {
    name:'Aria · After-Hours Closer',
    status:'Active now · 11:47pm',
    msgs:[
      {t:'u',text:"Hi — I'm looking for a real estate attorney. Not sure if you're the right fit."},
      {t:'ai',text:"Hey! You've come to the right place. What's the situation — are you buying, selling, or dealing with a dispute?"},
      {t:'u',text:"Buying commercial property. It's a $1.8M deal and I want someone experienced."},
      {t:'ai',text:"We handle transactions at that level regularly — our team has closed over $200M in commercial real estate. The key questions for a deal this size are timing and due diligence complexity. How soon are you looking to close?"},
