  .foot-inner{flex-direction:column;gap:20px;text-align:center;}.fr{grid-template-columns:1fr;}
  .dash-metrics{grid-template-columns:1fr 1fr;}
}
@media(max-width:600px){.price-grid{grid-template-columns:1fr;}h1{letter-spacing:-2px;}}
</style>
