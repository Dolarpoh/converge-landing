/* ── MODAL ── */
.modal-ov{position:fixed;inset:0;background:rgba(6,6,8,.92);backdrop-filter:blur(12px);z-index:1000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;}
.modal-ov.open{opacity:1;pointer-events:all;}
.modal{background:var(--card);border:1px solid var(--border-light);border-radius:20px;padding:44px;max-width:500px;width:90%;transform:translateY(20px);transition:transform .3s;position:relative;max-height:90vh;overflow-y:auto;}
.modal-ov.open .modal{transform:translateY(0);}
.modal-close{position:absolute;top:20px;right:20px;background:none;border:none;color:var(--muted2);font-size:22px;cursor:pointer;transition:color .2s;line-height:1;}
.modal-close:hover{color:var(--white);}
.modal h3{font-family:'Syne',sans-serif;font-weight:800;font-size:26px;letter-spacing:-1px;margin-bottom:8px;}
.modal-sub{font-size:15px;color:var(--muted2);margin-bottom:28px;}
.fg{margin-bottom:14px;}
.fl{display:block;font-size:12px;color:var(--muted2);margin-bottom:6px;font-family:'DM Mono',monospace;}
.fi{width:100%;background:var(--deep);border:1px solid var(--border-light);border-radius:8px;padding:11px 16px;color:var(--white);font-size:14px;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;}
.fi:focus{border-color:var(--green);}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.fsub{width:100%;background:var(--green);color:var(--black);border:none;border-radius:8px;padding:14px;font-size:15px;font-weight:600;cursor:pointer;margin-top:8px;transition:all .2s;font-family:'DM Sans',sans-serif;}
.fsub:hover{background:#00ff88;box-shadow:0 0 30px var(--green-glow-s);}
.fdisc{font-size:12px;color:var(--muted);text-align:center;margin-top:12px;}

::-webkit-scrollbar{width:6px;}::-webkit-scrollbar-track{background:var(--black);}::-webkit-scrollbar-thumb{background:var(--border-light);border-radius:3px;}

@media(max-width:1000px){
