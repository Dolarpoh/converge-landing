    status:'Active now',
    msgs:[
      {t:'u',text:"We're already looking at Intercom. Why should we use Converge instead?"},
      {t:'ai',text:"Great question — they're actually quite different tools. Intercom is built for <strong>customer support</strong>: tickets, agent routing, help docs. Converge is built for <strong>revenue generation</strong>: qualifying leads, handling objections, and driving people to buy."},
      {t:'u',text:"We need both support and sales though."},
      {t:'ai',text:"A lot of teams do. The good news: Converge handles the sales side and integrates with your support stack. You could run Intercom for tickets and Converge for conversions. Many customers do exactly that — and they say Converge pays for itself while Intercom is a cost center."},
      {t:'u',text:"That's actually a good point. How do I get started?"},
    ],
    outcome:{icon:'✓',text:'Trial started — converting from evaluation'}
  }
];

let activeScenario=0;
let convoTimer=null;

function switchConvo(idx,el){
  document.querySelectorAll('.convo-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  activeScenario=idx;
  playScenario(idx);
}

function playScenario(idx){
  clearTimeout(convoTimer);
  const sc=scenarios[idx];
  const msgsEl=document.getElementById('convoMsgs');
  const outcomeEl=document.getElementById('convoOutcome');
  const nameEl=document.getElementById('convoPHName');
  const statusEl=document.getElementById('convoPHStatus');

  msgsEl.innerHTML='';
  outcomeEl.classList.remove('show');
  nameEl.textContent=sc.name;
  statusEl.textContent=sc.status;
  document.getElementById('coIcon').textContent=sc.outcome.icon;
  document.getElementById('coText').textContent=sc.outcome.text;

  let delay=200;
  sc.msgs.forEach((msg,i)=>{
    convoTimer=setTimeout(()=>{
      const d=document.createElement('div');
      d.className=msg.t==='u'?'cm cm-u':'cm cm-ai';
      d.innerHTML=`<div class="cm-b">${msg.text}</div><div class="cm-label">${msg.t==='u'?'Visitor':'Converge AI'}</div>`;
      msgsEl.appendChild(d);
      msgsEl.scrollTop=msgsEl.scrollHeight;
      requestAnimationFrame(()=>requestAnimationFrame(()=>d.classList.add('show')));
      if(i===sc.msgs.length-1){
        setTimeout(()=>{outcomeEl.classList.add('show');},600);
      }
    },delay);
    delay+=msg.t==='u'?700:1100;
  });
}

// Auto-cycle scenarios
let autoCycleTimer=null;
function startAutoCycle(){
  autoCycleTimer=setInterval(()=>{
    const next=(activeScenario+1)%scenarios.length;
    const tabs=document.querySelectorAll('.convo-tab');
    tabs.forEach(t=>t.classList.remove('active'));
    tabs[next].classList.add('active');
    activeScenario=next;
    playScenario(next);
  },9000);
}

// Start on page load
window.addEventListener('load',()=>{
  playScenario(0);
  startAutoCycle();
});

// Pause auto-cycle when user interacts
document.querySelectorAll('.convo-tab').forEach(t=>{
  t.addEventListener('click',()=>{
    clearInterval(autoCycleTimer);
    setTimeout(startAutoCycle,20000);
  });
});

// ── ONBOARDING STEPS ──
function selStep(idx,el){document.querySelectorAll('.ob-item').forEach(i=>i.classList.remove('active'));el.classList.add('active');for(let i=0;i<=3;i++){const s=document.getElementById('ostep'+i);if(s)s.style.display=i===idx?'block':'none';}}

// ── CODE COPY ──
function copyCode(btn){btn.textContent='Copied!';btn.style.color='var(--green)';setTimeout(()=>{btn.textContent='Copy';btn.style.color='';},2000);}

// ── FAQ ──
function toggleFAQ(el){const item=el.parentElement;const wasOpen=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));if(!wasOpen)item.classList.add('open');}

// ── ROI CALC ──
function fmt(n){if(n>=1000000)return'$'+(n/1000000).toFixed(1)+'M';if(n>=1000)return'$'+(n/1000).toFixed(0)+'k';return'$'+Math.round(n);}
function fmtN(n){if(n>=1000)return(n/1000).toFixed(1)+'k';return Math.round(n).toString();}
function calcROI(){
  const v=+document.getElementById('vSlide').value;
  const c=+document.getElementById('cSlide').value/100;
  const aov=+document.getElementById('aSlide').value;
  document.getElementById('vDisp').textContent=v>=1000?(v/1000).toFixed(1)+'k':v;
  document.getElementById('cDisp').textContent=(c*100).toFixed(1)+'%';
  document.getElementById('aDisp').textContent=aov>=1000?'$'+(aov/1000).toFixed(1)+'k':'$'+aov;
  const curr=v*c*aov;
  const newR=Math.min(c*3.2,.25);
  const nRev=v*newR*aov;
  const lift=nRev-curr;
  const leads=Math.round(v*(newR-c));
  const roi=lift>0?Math.round(lift/149):0;
  document.getElementById('roiMain').textContent=fmt(lift);
  document.getElementById('roiCurr').textContent=fmt(curr);
  document.getElementById('roiNew').textContent=fmt(nRev);
  document.getElementById('roiLeads').textContent=fmtN(leads);
  document.getElementById('roiROI').textContent=roi+'×';
}
calcROI();

// ── SCROLL ANIMATIONS ──
const obs=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.style.opacity='1';e.target.style.transform='translateY(0)';}});},{threshold:.08});
document.querySelectorAll('.feat-card,.proof-card,.price-card,.how-step,.for-card').forEach(el=>{el.style.opacity='0';el.style.transform='translateY(20px)';el.style.transition='opacity .5s ease,transform .5s ease';obs.observe(el);});
